{
  "name": "cws-ranking-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "probe": "node --import tsx src/probe.ts",
    "matrix": "node --import tsx src/matrix.ts",
    "repeat": "node --import tsx src/repeatability.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "worker:dev": "wrangler dev --test-scheduled",
    "worker:build": "wrangler deploy --dry-run --outdir dist-worker",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.144.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}
