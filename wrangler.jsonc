{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ext-probe",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "TOP_N": "50",
    "COLLECTION_DELAY_MS": "1000",
    "BATCH_SIZE": "6",
    "REFRESH_HOURS": "20"
  },
  "secrets": {
    "required": ["DATABASE_URL"]
  },
  "observability": {
    "enabled": true
  }
}
